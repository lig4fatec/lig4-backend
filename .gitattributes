spring.application.name=lig4-backend

# === Servidor ===
# Em hospedagem a porta vem da variável PORT; localmente continua 8080.
server.port=${PORT:8080}
# Atrás do proxy do Render, usa o protocolo (https/wss) e o host reais
server.forward-headers-strategy=framework

# === Banco (PostgreSQL) ===
# Local: valores padrão abaixo. No deploy: DB_URL, DB_USER e DB_PASSWORD.
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/lig4}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}

# Pool pequeno que devolve conexões ociosas, para o banco gratuito do Neon poder dormir
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=0
spring.datasource.hikari.idle-timeout=60000
spring.datasource.hikari.max-lifetime=180000

# Schema é criado pelo Flyway, não pelo Hibernate
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true

# === OpenAPI / Swagger UI ===
springdoc.api-docs.path=/openapi
springdoc.swagger-ui.path=/swagger-ui


# === Origens do front-end permitidas (CORS e WebSocket) ===
# Separe por vírgula. Aceita curinga de subdomínio, por exemplo https://*.netlify.app
# No deploy, troque pela variável de ambiente LIG4_ORIGENS_PERMITIDAS.
lig4.origens-permitidas=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000